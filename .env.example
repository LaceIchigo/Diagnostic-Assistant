# Audio device configuration
# Use `python -c "import sounddevice; print(sounddevice.query_devices())"` to list devices
AUDIO_DEVICE_INDEX=0
AUDIO_DEVICE_NAME=default

# Model configuration
MODEL_SIZE=medium
LANGUAGE=ro

# Whisper model cache directory
WHISPER_MODEL_DIR=~/.cache/whisper

# Pyannote configuration (required for diarization)
# Get your token at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Pipeline configuration
CHUNK_DURATION=1.5
OVERLAP_DURATION=0.5
VAD_THRESHOLD=0.5

# Output configuration
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# UI configuration
STREAMLIT_PORT=8501
